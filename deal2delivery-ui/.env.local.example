# Databricks SQL Warehouse
# Host: your workspace URL without https:// (e.g. adb-1234567890.12.azuredatabricks.net)
DATABRICKS_HOST=

# Personal Access Token: User Settings → Developer → Access Tokens → Generate New Token
DATABRICKS_TOKEN=

# HTTP Path: SQL Warehouses → your warehouse → Connection Details → HTTP Path
# Looks like: /sql/1.0/warehouses/abc1234def5678
DATABRICKS_HTTP_PATH=

# OpenAI — for the GPT-4o insight strip, risk explainer, and AI agent router
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Databricks Genie Space ID — for the Ask AI natural language query feature
# Find it in your Genie space URL: .../genie/spaces/{THIS_ID}
DATABRICKS_GENIE_SPACE_ID=

# Databricks Job ID for gold views refresh — optional, for the trigger_refresh action
# Find it: Workflows → your gold_views_refresh job → Job ID in the URL
# If not set, refresh requests are logged to a Delta table instead
DATABRICKS_JOB_ID_GOLD_VIEWS=
